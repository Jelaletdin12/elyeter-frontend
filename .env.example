# Backend base URL — sunucu tarafı (Server Component / Route Handler) çağrılarında kullanılır.
API_BASE_URL=http://localhost:3000

# Backend base URL — tarayıcıdan yapılan çağrılar için (TanStack Query, Client Component).
# Genelde aynı backend'e proxy/CORS ile açık bir adres.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# MinIO / medya host'u — next.config.ts'teki images.remotePatterns için.
NEXT_PUBLIC_MEDIA_HOST=localhost

# app/api/revalidate/route.ts'i korumak için paylaşılan secret.
# Sunucu route'u REVALIDATE_SECRET'ı okur; client (lib/api/revalidate.ts)
# aynısını NEXT_PUBLIC_REVALIDATE_SECRET olarak x-revalidate-secret
# header'ında gönderir — İKİSİ BİRBİRİYLE AYNI OLMALI.
REVALIDATE_SECRET=change-me
NEXT_PUBLIC_REVALIDATE_SECRET=change-me

# httpOnly refresh cookie'nin adı (login/refresh route handler'ları arasında paylaşılır).
# Müşteri (customer) tarafı için.
REFRESH_COOKIE_NAME=refresh_token

# Admin paneli için AYRI cookie — müşteri cookie'siyle KESİNLİKLE aynı isim
# olmamalı. Aynı isim olsaydı: aynı tarayıcıda admin girişi yapan biri,
# müşteri sitesini açtığında yanlışlıkla admin olarak görünürdü (ve tersi).
ADMIN_REFRESH_COOKIE_NAME=admin_refresh_token
